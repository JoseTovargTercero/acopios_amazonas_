# Activa el motor de reescritura de URLs
RewriteEngine On

# -------------------------------------------------------------
# REGLAS DE SEGURIDAD
# -------------------------------------------------------------

# 1. Deshabilitar la visualizacion de los contenidos de los directorios
# Evita que los visitantes puedan ver una lista de archivos en una carpeta.
Options -Indexes

# 2. Bloquear el acceso directo a carpetas sensibles
# Devuelve un error 403 (Prohibido) si alguien intenta acceder a estas carpetas.
# Anade aqui todas las carpetas que contengan logica interna.
RewriteRule ^(controllers|models|views|core|config)/ - [F,L]

# 3. Bloquear el acceso directo a archivos especificos
# Protege archivos criticos como el propio Router.php
RewriteRule ^(Router\.php)$ - [F,L]


# -------------------------------------------------------------
# REGLAS DEL ENRUTADOR (FRONT CONTROLLER)
# -------------------------------------------------------------

# Condicion: si la URL solicitada NO es un archivo existente
RewriteCond %{REQUEST_FILENAME} !-f
# Condicion: si la URL solicitada NO es un directorio existente
RewriteCond %{REQUEST_FILENAME} !-d

# Regla: Redirige todas las demas solicitudes a index.php
# Esto permite que tu enrutador PHP maneje la URL sin importar el nombre de la carpeta.
RewriteRule ^(.*)$ index.php [QSA,L]
